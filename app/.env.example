# Local Supabase (from `npx supabase start`) or your hosted project's API settings.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-the-anon-or-publishable-key-here
# Optional: pin the in-app clock, e.g. to see the sample trip "in progress".
EXPO_PUBLIC_DEMO_NOW=2027-02-15T10:40
# Optional: show a password sign-in for test users created in Supabase (Authentication > Users > Add user, Auto Confirm).
# EXPO_PUBLIC_PASSWORD_LOGIN=1
# "Kokeile demoa" on the login page: opens the demo trip (supabase/migrations/20261118090000_demo_trip.sql)
# through the demo-login edge function. Works with the real Supabase project; no demo server needed.
# EXPO_PUBLIC_DEMO_LOGIN=1
